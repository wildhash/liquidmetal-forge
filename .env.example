# Liquid Metal Forge Configuration

# Monitoring Configuration
MONITORING_TARGETS=http://localhost:3000,http://localhost:8080
MONITORING_INTERVAL=10000
HEALTH_CHECK_TIMEOUT=5000

# Healing Configuration
AUTO_HEALING_ENABLED=true
SAFETY_CHECKS_ENABLED=true
MAX_FIX_SIZE_LINES=100
BACKUP_BEFORE_HEALING=true

# Decision Engine Configuration
LEARNING_MEMORY_LIMIT=1000
MIN_CONFIDENCE_THRESHOLD=0.5
MIN_DECISION_SCORE=0.6

# Kestra Configuration
KESTRA_URL=http://localhost:8080
KESTRA_NAMESPACE=selfhealing

# Dashboard Configuration
DASHBOARD_PORT=3000
WEBSOCKET_PORT=3001
REAL_TIME_UPDATES=true

# CodeRabbit Configuration
CODERABBIT_ENABLED=true
AUTO_REVIEW_ON_HEAL=true

# Cline Integration
CLINE_API_URL=http://localhost:9000
CLINE_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
