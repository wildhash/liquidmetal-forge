{
  "name": "liquidmetal-forge",
  "version": "1.0.0",
  "description": "Self-healing, self-optimizing software systems that autonomously detect failures, rewrite themselves, and redeploy",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:all": "npm run build && cd services/nanoforge-target && npm run build && cd ../monitor && npm run build && cd ../../packages/oumi-lite && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "demo": "tsx demo.ts",
    "test": "jest",
    "test:integration": "./scripts/integration-test.sh",
    "test:selftest": "./scripts/selftest.sh",
    "lint": "eslint src --ext .ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build --no-cache",
    "setup": "npm install && cd services/nanoforge-target && npm install && cd ../monitor && npm install && cd ../../packages/oumi-lite && npm install && cd ../../apps/dashboard && npm install"
  },
  "keywords": [
    "self-healing",
    "autonomous",
    "monitoring",
    "orchestration",
    "kestra",
    "cline",
    "oumi",
    "vercel",
    "coderabbit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
